APP_NAME=MyPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:58000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ
APP_TIMEZONE=Asia/Tashkent

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=mypos
DB_USERNAME=mypos
DB_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated list of allowed origins for WS upgrade. Use "*" only in dev.
# Example prod value:
# REVERB_ALLOWED_ORIGINS=https://app.mypos.uz,https://kitchen.mypos.uz,https://qr.mypos.uz
REVERB_ALLOWED_ORIGINS=*

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

FILESYSTEM_DISK=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mypos-local
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mypos.uz"
MAIL_FROM_NAME="${APP_NAME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_ENABLED=true
ANTHROPIC_TIMEOUT=120
ANTHROPIC_PUBLIC_HOURLY_LIMIT=5

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_WEBHOOK_ALLOWED_IPS=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_WEBHOOK_ALLOWED_IPS=

# Phase 4 — fallback FX provider (when CBU/NBP/NBKR return empty)
FIXER_ACCESS_KEY=

# Set to "true" only in local/testing dev environments where you want the
# legacy `sign_string=stub_ok` shortcut. NEVER set in production — the
# provider classes additionally hard-refuse stub mode in production.
PAYMENT_ALLOW_STUB_WEBHOOKS=false

SANCTUM_STATEFUL_DOMAINS=localhost:3001,localhost:3002,localhost:3003,localhost:3004,localhost:3005

# --- Phase 3 — EAS (Expo Application Services) Native App Builder --------
# Personal-access token from https://expo.dev/accounts/<org>/settings/access-tokens
# with permission to dispatch builds. Required for POST /api/v1/admin/apps/{id}/build.
EAS_ACCESS_TOKEN=
# Expo project UUID — single project shared across tenants when build_account=mypos.
EAS_PROJECT_ID=
# HMAC secret used to verify EAS build webhooks (Agent D3 surface).
EAS_WEBHOOK_SECRET=
# White-label Expo template that EAS clones for every build. Bumping the ref
# (default `main`) lets ops roll out new template versions without code changes.
EAS_TEMPLATE_REPO=https://github.com/mypos-uz/mobile-consumer-template
EAS_TEMPLATE_REF=main
# HTTP timeouts (seconds) for the EAS REST client.
EAS_DISPATCH_TIMEOUT=60
EAS_POLL_TIMEOUT=15

# --- Caddy / on-demand TLS for custom restaurant domains -----------------
# CADDY_INTERNAL_TOKEN — shared secret. Caddy must send this in the
# `X-Caddy-Token` header when calling /api/internal/caddy/verify. Generate
# with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
# In production, leaving this blank fails-closed (rejects all verify calls).
CADDY_INTERNAL_TOKEN=
# Set to "true" only if Caddy and the API are colocated on the same node and
# you want to skip the secret check for loopback callers in production.
CADDY_TRUST_LOOPBACK=false
# Caddy admin API. Default :2019 on the Caddy host's loopback interface.
CADDY_ADMIN_URL=http://127.0.0.1:2019
