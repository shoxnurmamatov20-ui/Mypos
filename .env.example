# Root-level shared env (each app has its own .env.example for specifics)

# Environment
NODE_ENV=development

# API
API_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

# Reverb (WebSocket)
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_APP_ID=mypos-local
REVERB_APP_KEY=mypos-key-local
REVERB_APP_SECRET=mypos-secret-local

# MySQL via XAMPP (ADR-0005, 2026-05-10) — NOT Docker.
# Start MySQL from XAMPP Control Panel; create `mypos` database in phpMyAdmin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mypos
DB_USERNAME=root
DB_PASSWORD=

# Redis (56379 to avoid clash with other local Redis)
REDIS_HOST=localhost
REDIS_PORT=56379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=mypos_minio_local
MINIO_SECRET_KEY=mypos_minio_local_secret
MINIO_BUCKET=mypos-local

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=mypos_meili_local

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Payment providers (leave empty for local dev)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
